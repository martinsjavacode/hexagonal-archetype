# Dynatrace Configuration
DYNATRACE_API_TOKEN=your-dynatrace-api-token-here
DYNATRACE_URI=https://your-environment-id.live.dynatrace.com/api/v2/metrics/ingest
DYNATRACE_OTLP_ENDPOINT=https://your-environment-id.live.dynatrace.com/api/v2/otlp/v1/traces
DYNATRACE_ENVIRONMENT=development
DYNATRACE_SERVICE_VERSION=1.0.0
DYNATRACE_SECURITY_CONTEXT=

# Alternative for SaaS environments
# DYNATRACE_URI=https://{your-environment-id}.live.dynatrace.com/api/v2/metrics/ingest
# DYNATRACE_OTLP_ENDPOINT=https://{your-environment-id}.live.dynatrace.com/api/v2/otlp/v1/traces

# Alternative for Managed environments  
# DYNATRACE_URI=https://{your-domain}/e/{your-environment-id}/api/v2/metrics/ingest
# DYNATRACE_OTLP_ENDPOINT=https://{your-domain}/e/{your-environment-id}/api/v2/otlp/v1/traces
